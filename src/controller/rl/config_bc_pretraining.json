{
  "schema_version": 1,
  "model": {
    "observation_dim": 6,
    "hidden_units": [128, 128],
    "action_dim": 6,
    "hidden_activation": "relu",
    "output_activation": "tanh"
  },
  "training": {
    "seeds": [7, 17, 29],
    "learning_rate": 0.0003,
    "batch_size": 128,
    "gradient_updates": 1500,
    "evaluation_interval": 50,
    "optimizer": "adam",
    "loss": "weighted_mse_in_normalized_action_space"
  },
  "split": {
    "validation_families": ["Edinburgh", "FullExtension"],
    "unit": "session_and_trajectory_family"
  },
  "augmentation": {
    "ratios": [0.25, 0.5, 1.0],
    "primary_ratio": 0.5,
    "physics_loss_weight": 1.0,
    "sampling_method": "convex_interpolation_between_two_recorded_targets_in_same_training_session",
    "interpolation_alpha_range": [0.15, 0.85],
    "minimum_novelty_deg": 0.05,
    "maximum_attempt_multiplier": 200,
    "c3_repeat_ratio": 1.0,
    "random_seed": 20261028
  },
  "data": {
    "decision_hz": 5.0,
    "observation": [
      "q0_plan_DIP_rad", "q0_plan_PIP_rad", "q0_plan_MCP_rad",
      "q_target_DIP_rad", "q_target_PIP_rad", "q_target_MCP_rad"
    ],
    "action_reference": "session_plan_origin",
    "action_unit": "mm"
  }
}
