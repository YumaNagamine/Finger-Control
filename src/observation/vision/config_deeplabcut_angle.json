{
  "input": {
    "mode": "camera",
    "video_path": ""
  },
  "dlc": {
    "third_party_path": "third_party/deeplabcut",
    "model_path": "models/deeplabcut_export",
    "pcutoff": 0.0,
    "default_likelihood": 0.0,
    "convert_bgr_to_rgb": true
  },
  "keypoints": {
    "names": [
      "distal_tip",
      "distal_base",
      "medial_tip",
      "medial_base",
      "proximal_tip",
      "proximal_base",
      "palm_tip",
      "palm_base"
    ],
    "segments": {
      "distal": [
        "distal_tip",
        "distal_base"
      ],
      "medial": [
        "medial_tip",
        "medial_base"
      ],
      "proximal": [
        "proximal_tip",
        "proximal_base"
      ],
      "palm": [
        "palm_tip",
        "palm_base"
      ]
    }
  },
  "angles": [
    {
      "name": "angle_0",
      "segment_a": "distal",
      "segment_b": "medial"
    },
    {
      "name": "angle_1",
      "segment_a": "medial",
      "segment_b": "proximal"
    },
    {
      "name": "angle_2",
      "segment_a": "proximal",
      "segment_b": "palm"
    }
  ],
  "processing": {
    "confidence_threshold": 0.6,
    "ema_alpha": 0.4,
    "hold_last_frames": 4
  },
  "draw": {
    "show_keypoint_labels": true,
    "keypoint_radius": 4,
    "line_thickness": 2
  },
  "output": {
    "csv_dir": "logs/deeplabcut_test/csv",
    "overlay_video_dir": "logs/deeplabcut_test/video",
    "filename_prefix": "dlc_angle",
    "save_overlay_video": true,
    "show_window": true,
    "fallback_fps": 30.0
  }
}
