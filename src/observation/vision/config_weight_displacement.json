{
  "input": {
    "mode": "camera",
    "video_path": ""
  },
  "measurement": {
    "pipeline": "weight_marker",
    "camera_id": "cam0",
    "num_weights": 6,
    "marker_ids": [0, 1, 2, 3, 4, 5],
    "baseline_frames": 3,
    "positive_direction": "up"
  },
  "processing": {
    "aruco": {
      "dictionary": "DICT_4X4_50",
      "marker_length_mm": 18.0
    }
  },
  "output": {
    "csv_dir": "output/weight_csv",
    "overlay_video_dir": "output/weight_video",
    "filename_prefix": "weight_disp",
    "save_overlay_video": true,
    "show_window": true,
    "fallback_fps": 30.0
  }
}
